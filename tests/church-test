(define zero (lambda (f) (lambda (x) x)))
(define succ (lambda (n) (lambda (f) (lambda (x) (f ((n f) x))))))
(define one (succ zero))
(define two (succ one))
(define three (succ two))
(define inc (lambda (x) (+ x 1)))
(define to-int (lambda (n) ((n inc) 0)))
(define add (lambda (m n) (lambda (f) (lambda (x) ((m f) ((n f) x))))))
(define mul (lambda (m n) (lambda (f) (m (n f)))))

(assert (=? (to-int zero) 0))
(assert (=? (to-int one) 1))
(assert (=? (to-int two) 2))
(assert (=? (to-int three) 3))
(assert (=? (to-int (add two three)) 5))
(assert (=? (to-int (mul two three)) 6))
(assert (=? (to-int (mul zero three)) 0))

(define saved (two inc))
(assert (=? (saved 10) 12))
(assert (=? (saved 20) 22))
(define outer (lambda (x) (lambda (y) (lambda (z) (+ x y z)))))
(define inner ((outer 10) 20))
(assert (=? (inner 3) 33))
(define held (let ((x 40)) (lambda (y) (+ x y))))
(assert (=? (held 2) 42))
